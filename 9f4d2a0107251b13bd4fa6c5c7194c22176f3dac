      "writtenOn": "2025-09-09T08:12:18Z",
      "side": 1,
      "message": "shouldn\u0027t this be covered by the init lock?  why does it need to be an atomic?",
      "range": {
        "startLine": 166,
        "startChar": 5,
        "endLine": 166,
        "endChar": 16
      },
      "revId": "9f4d2a0107251b13bd4fa6c5c7194c22176f3dac",
