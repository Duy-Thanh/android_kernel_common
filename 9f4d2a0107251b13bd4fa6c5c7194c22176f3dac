    {
      "unresolved": true,
      "key": {
        "uuid": "8c29a993_70c10a36",
        "filename": "drivers/block/zram/zram_ioctl.c",
        "patchSetId": 8
      },
      "lineNbr": 166,
      "author": {
        "id": 3489357
      },
      "writtenOn": "2025-09-09T08:34:45Z",
      "side": 1,
      "message": "-\u003einit_lock is a writer lock only during device init/reset, in all other cases it\u0027s a reader lock. post-processing-in-progress flag can be modified from many CPUs, e.g. recompression request on CPU0 racing writeback request on CPU1, etc. We want only one active post-processing context at a time (this dramatically simplifies things).",
      "parentUuid": "b7456237_606759ff",
      "range": {
        "startLine": 166,
        "startChar": 5,
        "endLine": 166,
        "endChar": 16
      },
      "revId": "9f4d2a0107251b13bd4fa6c5c7194c22176f3dac",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
