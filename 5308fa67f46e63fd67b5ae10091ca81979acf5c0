      },
      "writtenOn": "2026-10-21T17:58:52Z",
      "side": 1,
      "message": "This isn\u0027t valid after aosp/4356148, since mappings are not inherited across fork.",
      "range": {
        "startLine": 866,
        "startChar": 2,
        "endLine": 866,
        "endChar": 55
      },
      "revId": "5308fa67f46e63fd67b5ae10091ca81979acf5c0",
