# ----------------------------------------------------------------------------
# PART A: Known Kernel / Architectural Limitations (Assignee: jyescas@)
# ----------------------------------------------------------------------------

# [b/562752028] [Kernel] KeyMint AIDL target tests shared memory 16KB alignment / attestation (ref b/520042674)
--exclude-filter VtsAidlKeyMintTargetTest


# ----------------------------------------------------------------------------
# PART B: Non-Kernel Userspace / Framework Noise (Excluded from GKI Gating)
# Routed to 16KB Userspace/Platform Leads (Assignee: kaleshsingh@)
# ----------------------------------------------------------------------------

# [b/562752249] [Non-Kernel] Native NDK ABI allowlist check (31.6% of all 16KB failures, ref b/525270802)
--exclude-filter CtsNativeNdkAllowlistTest
--exclude-filter CtsAllowlistTestCases

# [b/562751263] [Non-Kernel] Heavy Framework suites hitting OOM/Timeouts under 16K RAM overhead
--exclude-filter CtsAutoFillServiceTestCases
--exclude-filter CtsAutoFillServiceTestCases[instant]
--exclude-filter CtsHealthFitnessDeviceTestCases
--exclude-filter CtsAppFunctionTestCases
--exclude-filter CtsCompanionDeviceManagerCoreTestCases
--exclude-filter CtsPersonalContextTestCases

# [b/562751876] [Non-Kernel] DevicePolicy multi-user profile timeouts under 16KB (ref b/526469727, b/565432492)
--exclude-filter CtsDevicePolicyTestCases
--exclude-filter CtsDevicePolicyTestCases[run-on-clone-profile]
--exclude-filter CtsDevicePolicyTestCases[run-on-private-profile]
--exclude-filter CtsDevicePolicyTestCases[run-on-secondary-user]
--exclude-filter CtsDevicePolicyTestCases[run-on-work-profile]
--exclude-filter CtsDevicePolicyManagerTestCases

# [b/562752306] [Non-Kernel] dEQP / Graphics 4KB buffer alignment assumptions (ref b/489255903)
--exclude-filter CtsDeqpTestCases
--exclude-filter CtsGraphicsTestCases
--exclude-filter CtsUiRenderingTestCases

# [b/562752426] [Non-Kernel] Mainline Telecom / MockModem timeouts (ref b/491401787)
--exclude-filter MctsTelecomTestCases
--exclude-filter CtsTelephonyTestCases
--exclude-filter CtsTelephonyProviderTestCases
