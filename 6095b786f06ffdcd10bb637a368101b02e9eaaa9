        "id": 1157738
      },
      "writtenOn": "2024-02-15T23:49:33Z",
      "side": 1,
      "message": "Can we simply add this check before original vmf_allows_speculation() in the very beginning and be done with it? It looks like for this condition you should always return VM_FAULT_SIGBUS, so why not check this once at the beginning and bail out early?",
      "parentUuid": "e4dc15da_6d3bfd3e",
      "range": {
        "startLine": 5222,
        "startChar": 1,
