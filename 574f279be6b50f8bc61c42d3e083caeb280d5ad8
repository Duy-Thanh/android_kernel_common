        "id": 1125653
      },
      "writtenOn": "2025-09-11T09:13:38Z",
      "side": 1,
      "message": "why can this not just be an external vendor module?",
      "revId": "574f279be6b50f8bc61c42d3e083caeb280d5ad8",
