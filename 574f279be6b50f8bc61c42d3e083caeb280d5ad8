      "writtenOn": "2025-08-28T22:08:15Z",
      "side": 1,
      "message": "Why is this needed in android-mainline? Please submit this series upstream first.",
      "revId": "574f279be6b50f8bc61c42d3e083caeb280d5ad8",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
