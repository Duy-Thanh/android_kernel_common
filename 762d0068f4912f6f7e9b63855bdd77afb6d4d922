    {
      "key": {
        "uuid": "3225de0c_39f33a13",
        "filename": "block/blk-crypto.c",
        "patchSetId": 6
      },
      "lineNbr": 379,
      "author": {
        "id": 1137063
      },
      "writtenOn": "2019-05-03T22:17:01Z",
      "side": 1,
      "message": "AFAICS, the order in which things are checked makes this logic more complicated than needed.  Don\u0027t we just need:\n\n        if (bio_crypt_has_keyslot(bio)) {\n                /* Key already programmed into device? */\n                if (bio-\u003ebi_crypt_context.processing_ksm \u003d\u003d q-\u003eksm)\n                        return 0;\n\n                /* Nope, release the existing keyslot. */\n                blk_crypto_put_keyslot(bio);\n        }\n\n        /* Get device keyslot if supported, else fall back to software. */\n        if (q-\u003eksm) {\n                err \u003d blk_crypto_get_keyslot(bio, q-\u003eksm);\n                if (err)\n                        goto out_err;\n        } else {\n                err \u003d blk_crypto_get_keyslot(bio, blk_crypto_ksm);\n                if (err)\n                        goto out_err;\n                if (bio_data_dir(bio) \u003d\u003d WRITE) {\n                        /* Encrypt the data now */\n                        err \u003d blk_crypto_encrypt_bio(bio);\n                        if (err)\n                                goto out_encrypt_err;\n                }\n        }",
      "range": {
        "startLine": 347,
