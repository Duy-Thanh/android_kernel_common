      "writtenOn": "2022-09-07T11:00:38Z",
      "side": 1,
      "message": "no, this is not ok, sorry.  That\u0027s a horrible way to do an api, and it diverges from upstream.\n\nIf you need something \"odd\" for a flag, make a separate function in your hook logic instead.",
      "range": {
        "startLine": 441,
        "startChar": 51,
        "endLine": 441,
        "endChar": 70
      },
      "revId": "61814ef31ff3a8ab13e4c1a8bf86d6271ab787ad",
