      "writtenOn": "2024-04-02T10:16:50Z",
      "side": 1,
      "message": "The asymmetry with the pristine case bothers me a little here. Can this be \u0027\u003d\u0027 instead? If not, then why is it safe to assign `PKVM_PAGE_OWNED` in the other case?",
      "range": {
        "startLine": 2139,
        "startChar": 22,
        "endLine": 2139,
        "endChar": 24
      },
      "revId": "8950c6f0823f541298898209abf7eb02b2c44f82",
