      "writtenOn": "2020-07-20T15:38:32Z",
      "side": 1,
      "message": "This is changing the lock logic - we were adding the pending read within the lock before. Also, we can now have multiple readers adding pending reads. Are you sure this is OK?",
      "revId": "fb1cf81f7dee4e74f63a24d7a300e68f1b395ce0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
