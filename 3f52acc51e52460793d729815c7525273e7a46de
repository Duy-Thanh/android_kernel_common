      "writtenOn": "2025-05-07T17:51:28Z",
      "side": 1,
      "message": "Does this return to the host? If TZ got a non-secure interrupts, the host needs to handle that before retrying.",
      "revId": "3f52acc51e52460793d729815c7525273e7a46de",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
