      "author": {
        "id": 1809582
      },
      "writtenOn": "2025-05-13T03:36:00Z",
      "side": 1,
      "message": "I don\u0027t think this store or `FFA_VM_AVAIL_NOTIFIED_ALL` are needed anymore, at all.",
      "parentUuid": "75703b62_ec6aa5bf",
      "revId": "3f52acc51e52460793d729815c7525273e7a46de",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
