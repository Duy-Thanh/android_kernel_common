      },
      "lineNbr": 392,
      "author": {
        "id": 1956645
      },
      "writtenOn": "2023-10-25T22:55:24Z",
      "side": 1,
      "message": "If `module_init()` fails, the module will not be loaded and `module_exit()` will not be called. Some modules can offer degraded functionalities if failure is encountered during the init process, but the `memhealth` is not designed that way, therefore we close any successfully created entries.",
      "parentUuid": "a3208912_6a42751f",
      "revId": "6d1ec61d8fb168a07bcc48a1225f06ced45f004a",
