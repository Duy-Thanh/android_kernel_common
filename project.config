[project]
	description = Common Android Kernel Tree
[receive]
	requireSignedOffBy = true
[submit]
	action = fast forward only
[access]
	inheritFrom = Kernel-Projects
[access "refs/heads/*"]
	owner = group kernel-owners
	push = +force group kernel-owners
	create = group kernel-owners
	label-Code-Review = -2..+2 group kernel-approvers
	label-Code-Review = -2..+1 group kernel-committers
	label-Verified = -1..+1 group kernel-approvers
	label-Verified = -1..+1 group kernel-committers
	submit = group kernel-approvers
	submit = group kernel-committers
[notify "team-android-kernel"]
	email = android-kernel-team+aosp-reviews@google.com
	header = cc
	type = new_changes
[access "refs/tags/*"]
	delete = group kernel-admin
[access "refs/heads/android-4.4-eas-test"]
	label-Code-Review = -2..+2 group kernel-eas-approvers
[access "refs/heads/android-4.9-eas-dev"]
	label-Code-Review = -2..+2 group kernel-eas-approvers
[access "refs/heads/experimental/android-4.14-eas-integration"]
	label-Code-Review = -2..+2 group kernel-eas-approvers
[access "refs/heads/experimental/android-mainline-tracking"]
	label-Code-Review = -2..+2 group kernel-amt-approvers
	forgeAuthor = group kernel-amt-approvers
	forgeCommitter = group kernel-amt-approvers
	push = +force group kernel-amt-approvers
	pushMerge = group kernel-amt-approvers
[access "refs/tag/experimental/*"]
	create = group kernel-amt-approvers
	push = group kernel-amt-approvers
[access "refs/heads/experimental/eas-dev"]
	forgeAuthor = group kernel-amt-approvers
	forgeCommitter = group kernel-amt-approvers
	label-Code-Review = -2..+2 group kernel-amt-approvers
	push = group kernel-amt-approvers
	pushMerge = group kernel-amt-approvers
