      "writtenOn": "2023-06-20T02:40:58Z",
      "side": 1,
      "message": "The other upstream 5 patches are all about deadline sched class and set_scheduler, and in kernel5.15, the cpuset has little to do with these.",
      "parentUuid": "29922a11_51f59ca6",
      "revId": "053a1774b696bf712c78bdc1f0d9321c4e0a380b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
