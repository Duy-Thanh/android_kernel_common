    {
      "key": {
        "uuid": "65e7ba73_8abd9730",
        "filename": "include/linux/iorw.h",
        "patchSetId": 1
      },
      "lineNbr": 12,
      "author": {
        "id": 1716199
      },
      "writtenOn": "2020-09-23T00:23:49Z",
      "side": 1,
      "message": "Hi Greg KH,\n\nYes. We just need address information. Data would be part of the CPU register when device crashes and ramdumps help to find the register contents/\n\nAddress information helps, what peripheral address cpu last read/write.",
      "parentUuid": "5bb80d06_6a8e9794",
      "range": {
        "startLine": 11,
        "startChar": 0,
        "endLine": 12,
        "endChar": 52
