        "id": 1965911
      },
      "writtenOn": "2026-02-08T10:58:53Z",
      "side": 1,
      "message": "To avoid having extra SMCs in the future, we are thinking of having arg1 as a `function` where for now it can be `POWER_CTL` and the future we can expose extra functionality to the guest through the same HVC as CLK, regulators, DVFS...",
      "range": {
        "startLine": 566,
        "startChar": 10,
        "endLine": 566,
        "endChar": 32
      },
      "revId": "32163a35cbeb3b364c5d2e87cb3437c47db2f8b5",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
