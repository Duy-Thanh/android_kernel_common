    },
    {
      "unresolved": true,
      "key": {
        "uuid": "d0eea926_155c35c3",
        "filename": "arch/arm64/kernel/module-plts.c",
        "patchSetId": 9
      },
      "lineNbr": 222,
      "author": {
        "id": 1988540
      },
      "writtenOn": "2023-06-05T22:57:00Z",
      "side": 1,
      "message": "`count_plts` is simply used to find an upper bound on the number of PLTs that could be generated later on, doesnt need to be the exact number.\nSo if we ignore the kmalloc error here and not increment the count, there is a scenario where this would never be caught elsewhere and the kernel would function just fine. This happens when the actual number of PLTs generated is lower than the calculated upper bound.\nThat\u0027s why IMO, we shouldn\u0027t get rid of this check.",
      "parentUuid": "43f968a0_71d960c8",
      "range": {
        "startLine": 221,
        "startChar": 4,
        "endLine": 222,
        "endChar": 16
      },
      "revId": "cc26229554d8e740c0ad292882b1fd3c467bb60a",
