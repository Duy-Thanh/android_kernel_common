      "writtenOn": "2024-12-09T13:28:14Z",
      "side": 1,
      "message": "have you looked at the overhead of this function? The double loops in interrupt context could be an issue. Is it viable to do this from softirq context?",
      "range": {
        "startLine": 4138,
        "startChar": 2,
        "endLine": 4138,
        "endChar": 46
      },
      "revId": "17f01fe69b5e8feff59e575f9bcf34a57f6d9828",
