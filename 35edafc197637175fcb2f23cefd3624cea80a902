        "id": 1942270
      },
      "writtenOn": "2025-06-03T11:10:31Z",
      "side": 1,
      "message": "My understanding is that we won\u0027t accept any requests if the availability message is not sent but @ahomescu@xwf.google.com can confirm",
      "parentUuid": "07cc9822_aedec800",
      "range": {
        "startLine": 1600,
        "startChar": 4,
        "endLine": 1600,
        "endChar": 33
      },
      "revId": "35edafc197637175fcb2f23cefd3624cea80a902",
