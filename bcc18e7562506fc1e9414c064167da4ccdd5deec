      "side": 1,
      "message": "Why exactly this is needed? Why can\u0027t we just check pkvm_pviommu_enabled() everywhere?",
      "revId": "bcc18e7562506fc1e9414c064167da4ccdd5deec",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "a7db6a40_84633953",
        "filename": "drivers/iommu/intel/iommu.h",
        "patchSetId": 34
