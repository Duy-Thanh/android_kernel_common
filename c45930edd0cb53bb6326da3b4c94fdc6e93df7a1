      "message": "Cherry pick is not clean. Checked against UPSTREAM.\nUPSTREAM commit: [googlesource](https://android.googlesource.com/kernel/common/+/22d4368bd23c93de6b1bc3ef91967c34be160141) [kernel.org](https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id\u003d22d4368bd23c93de6b1bc3ef91967c34be160141).\n\n```\n      ## fs/f2fs/segment.c ##\n     @@ fs/f2fs/segment.c: static void get_new_segment(struct f2fs_sb_info *sbi,\n    - \tunsigned int old_zoneno \u003d GET_ZONE_FROM_SEG(sbi, *newseg);\n      \tbool init \u003d true;\n    + \tint go_left \u003d 0;\n      \tint i;\n     +\tint ret \u003d 0;\n      \n      \tspin_lock(\u0026free_i-\u003esegmap_lock);\n      \n     @@ fs/f2fs/segment.c: find_other_zone:\n    - \tif (secno \u003e\u003d MAIN_SECS(sbi)) {\n    - \t\tsecno \u003d find_first_zero_bit(free_i-\u003efree_secmap,\n    - \t\t\t\t\t\t\tMAIN_SECS(sbi));\n    --\t\tf2fs_bug_on(sbi, secno \u003e\u003d MAIN_SECS(sbi));\n    + \t\tif (dir \u003d\u003d ALLOC_RIGHT) {\n    + \t\t\tsecno \u003d find_next_zero_bit(free_i-\u003efree_secmap,\n    + \t\t\t\t\t\t\tMAIN_SECS(sbi), 0);\n    +-\t\t\tf2fs_bug_on(sbi, secno \u003e\u003d MAIN_SECS(sbi));\n    ++\t\t\tif (secno \u003e\u003d MAIN_SECS(sbi)) {\n    ++\t\t\t\tret \u003d -ENOSPC;\n    ++\t\t\t\tgoto out_unlock;\n    ++\t\t\t}\n    + \t\t} else {\n    + \t\t\tgo_left \u003d 1;\n    + \t\t\tleft_start \u003d hint - 1;\n    +@@ fs/f2fs/segment.c: find_other_zone:\n    + \t\t}\n    + \t\tleft_start \u003d find_next_zero_bit(free_i-\u003efree_secmap,\n    + \t\t\t\t\t\t\tMAIN_SECS(sbi), 0);\n    +-\t\tf2fs_bug_on(sbi, left_start \u003e\u003d MAIN_SECS(sbi));\n     +\t\tif (secno \u003e\u003d MAIN_SECS(sbi)) {\n     +\t\t\tret \u003d -ENOSPC;\n     +\t\t\tgoto out_unlock;\n     +\t\t}\n    + \t\tbreak;\n      \t}\n    - \tsegno \u003d GET_SEG_FROM_SEC(sbi, secno);\n    - \tzoneno \u003d GET_ZONE_FROM_SEC(sbi, secno);\n    + \tsecno \u003d left_start;\n     @@ fs/f2fs/segment.c: got_it:\n    