        "filename": "drivers/virt/coco/pkvm-guest/arm-pkvm-guest.c",
        "patchSetId": 5
      },
      "lineNbr": 120,
      "author": {
        "id": 1942270
      },
      "writtenOn": "2025-01-20T18:12:18Z",
      "side": 1,
      "message": "In that case I will set it to `true` only if the hypervisor service is available `and` hyp granule matches the guest page size.",
      "parentUuid": "3fa004b6_9d0e934a",
      "range": {
        "startLine": 120,
        "startChar": 10,
        "endLine": 120,
        "endChar": 22
      },
      "revId": "f3904405998322f2cca71bb27bf3751273426fa9",
