        "id": 1892347
      },
      "writtenOn": "2026-02-16T18:26:31Z",
      "side": 1,
      "message": "You should generally ensure that the driver does not UAF even if userspace does something you didn\u0027t plan for.\n\nThe easiest solution is probably to have a global xarray mapping the vma to the `wrap_ctx`.",
      "parentUuid": "5948602f_e6df205e",
      "range": {
        "startLine": 454,
        "startChar": 0,
        "endLine": 455,
        "endChar": 25
      },
      "revId": "1589b633d0d603a082d0717dd48759f6e8c0301d",
