        "id": 1045980
      },
      "writtenOn": "2017-12-20T03:30:52Z",
      "side": 1,
      "message": "Are you sure this won\u0027t upset any of the vfs locking assumptions? Normally this lock is held throughout d_delete",
      "range": {
        "startLine": 110,
        "startChar": 2,
        "endLine": 110,
        "endChar": 29
      },
      "revId": "9d6251bd6b7e4e69d43f9ace4fd3a3b6e1dcbeec",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
