        "id": 1572468
      },
      "writtenOn": "2025-02-11T15:43:20Z",
      "side": 1,
      "message": "Why is it safe to truncate? Presumably there will be SPs that expect to be notified but which won\u0027t be.",
      "range": {
        "startLine": 1170,
        "startChar": 53,
        "endLine": 1170,
        "endChar": 78
      },
      "revId": "0e31869112558cbf16eb0e153d2bc55c73443f68",
