7.246695][  T468]  ? count_memcg_events+0x7a/0x190\n\u003c4\u003e[  287.252531][  T468]  ? handle_mm_fault+0x88c/0xaa0\n\u003c4\u003e[  287.258162][  T468]  ? mt_find+0x2f3/0x410\n\u003c4\u003e[  287.263031][  T468]  kvm_vcpu_ioctl+0x657/0x840\n\u003c4\u003e[  287.268382][  T468]  __se_sys_ioctl+0x7a/0xd0\n\u003c4\u003e[  287.273548][  T468]  do_syscall_64+0x61/0xf10\n\u003c4\u003e[  287.278705][  T468]  ? arch_exit_to_user_mode_prepare+0x9/0xb0\n\u003c4\u003e[  287.285513][  T468]  asm_fred_entrypoint_user+0x41/0x41\n\u003c4\u003e[  287.291640][  T468] RIP: 0033:0x7c914c8e02a7\n\u003c4\u003e[  287.296700][  T468] Code: 00 00 00 b8 1b 00 00 00 0f 05 48 3d 01 f0 ff ff 73 01 c3 89 c7 e9 59 1b 07 00 66 0f 1f 84 00 00 00 00 00 b8 10 00 00 00 0f 05 \u003c48\u003e 3d 01 f0 ff ff 73 01 c3 89 c7 e9 39 1b 07 00 66 0f 1f 84 00 00\n\u003c4\u003e[  287.318758][  T468] RSP: 002b:00007c8ea2fa1038 EFLAGS: 00000206 ORIG_RAX: 0000000000000010\n\u003c4\u003e[  287.328282][  T468] RAX: ffffffffffffffda RBX: 00007c8ea2fa1c30 RCX: 0000000000000018\n\u003c4\u003e[  287.337328][  T468] RDX: 0000000000000000 RSI: 000000000000ae80 RDI: 000000000000006b\n\u003c4\u003e[  287.346366][  T468] RBP: 00007c8ea2fa1110 R08: 0000000000000000 R09: 0000000000000000\n\u003c4\u003e[  287.355397][  T468] R10: 00007c8ea2fa3a48 R11: 0000000000000007 R12: 00007c9061214480\n\u003c4\u003e[  287.364435][  T468] R13: 0000000000000001 R14: 00007c8ea2fa4260 R15: 00007c8ea2fa1410\n\u003c4\u003e[  287.373484][  T468]  \u003c/TASK\u003e\n\u003c4\u003e[  287.376989][  T468] ---[ end trace 0000000000000000 ]---\n...\n```\n\nBTW I actually never knew _why_ exactly S3 suspend didn\u0027t work for us with pKVM, and now I see at least one reason: S3 suspend involves offlining secondary CPUs, which is not supported by pKVM, for the reasons explained in aosp/3999613. So we may be able to enter S3 suspend, but then can\u0027t successfully resume from it, since we can\u0027t online those CPUs back.\n\nSo, with S3 suspend, secondary CPUs are offlined in pm_sleep_disable_secondary_cpus() which happens _before_ syscore_suspend() -\u003e iommu_suspend(). So if we reached iommu_suspend(), it is already too late.\n\n...So we\u0027d better implement a change similar to aosp/3999613, to disable _advertising_ S3 suspend in `/sys/power/mem_sleep`, so that userspace is not able to trigger it. (We don\u0027t need to implement it right now, we can do it some time later.)\n\nSo in the meantime, let\u0027s add WARN_ON here in iommu_suspend() as well?",
