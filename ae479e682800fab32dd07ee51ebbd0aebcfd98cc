      "writtenOn": "2025-06-11T15:20:20Z",
      "side": 1,
      "message": "OTOH it is not particularly hard to just return -ENOMEM and print an error message, why not just do that?",
      "parentUuid": "ac1cc38c_e4b501d8",
      "revId": "ae479e682800fab32dd07ee51ebbd0aebcfd98cc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
