      "side": 1,
      "message": "Why do we need to send destroy if create wasn\u0027t sent ?",
      "range": {
        "startLine": 320,
        "startChar": 6,
        "endLine": 323,
        "endChar": 37
      },
      "revId": "23504e24a5df876acd7006579ecff0f9d9c19451",
