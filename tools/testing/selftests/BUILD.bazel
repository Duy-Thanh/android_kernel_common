load(
    "//build/kernel/kleaf:kernel.bzl",
    "android_filegroup",
)

package(
    default_visibility = [
        "//visibility:private",
    ],
)

cc_library(
    name = "kselftest_headers_lib",
    hdrs = glob(["*.h"]),
)

cc_binary(
    name = "kselftest_binderfs_test",
    srcs = ["filesystems/binderfs/binderfs_test.c"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [":kselftest_headers_lib"],
)

cc_binary(
    name = "kselftest_breakpoints_tests_step_after_suspend_test",
    srcs = ["breakpoints/step_after_suspend_test.c"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [":kselftest_headers_lib"],
)

cc_binary(
    name = "kselftest_breakpoints_tests_breakpoint_test_x86_64",
    srcs = ["breakpoints/breakpoint_test.c"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [":kselftest_headers_lib"],
)

cc_binary(
    name = "kselftest_breakpoints_tests_breakpoint_test_arm64",
    srcs = ["breakpoints/breakpoint_test_arm64.c"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [":kselftest_headers_lib"],
)

android_filegroup(
    name = "kselftest_tests_x86_64",
    srcs = [
        ":kselftest_binderfs_test",
        ":kselftest_breakpoints_tests_breakpoint_test_x86_64",
        ":kselftest_breakpoints_tests_step_after_suspend_test",
    ],
    cpu = "x86_64",
    visibility = ["//visibility:public"],
)

android_filegroup(
    name = "kselftest_tests_arm64",
    srcs = [
        ":kselftest_binderfs_test",
        ":kselftest_breakpoints_tests_breakpoint_test_arm64",
        ":kselftest_breakpoints_tests_step_after_suspend_test",
    ],
    cpu = "arm64",
    visibility = ["//visibility:public"],
)
