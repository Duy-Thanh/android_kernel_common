<configuration description="kunit">
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer"/>

    <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
        <option name="cleanup" value="true" />
        <option name="push-file" key="kunit" value="/data/kunit" />
    </target_preparer>

    <result_reporter class="com.android.tradefed.result.ConsoleResultReporter" />

    <!-- Modules that leave the OS in an unstable state have been temporaily commented out. -->
    <test class="com.android.tradefed.testtype.binary.KUnitModuleTest" >
        <!-- <option name='binary' key='drivers/base/regmap/regmap-kunit' value='/data/kunit/drivers/base/regmap/regmap-kunit.ko' /> -->
        <option name='binary' key='drivers/base/regmap/regmap-ram' value='/data/kunit/drivers/base/regmap/regmap-ram.ko' />
        <option name='binary' key='drivers/base/regmap/regmap-raw-ram' value='/data/kunit/drivers/base/regmap/regmap-raw-ram.ko' />
        <option name='binary' key='drivers/hid/hid-uclogic-test' value='/data/kunit/drivers/hid/hid-uclogic-test.ko' />
        <!-- <option name='binary' key='drivers/iio/test/iio-test-format' value='/data/kunit/drivers/iio/test/iio-test-format.ko' /> -->
        <option name='binary' key='drivers/input/tests/input_test' value='/data/kunit/drivers/input/tests/input_test.ko' />
        <option name='binary' key='drivers/rtc/lib_test' value='/data/kunit/drivers/rtc/lib_test.ko' />
        <option name='binary' key='fs/ext4/ext4-inode-test' value='/data/kunit/fs/ext4/ext4-inode-test.ko' />
        <option name='binary' key='fs/fat/fat_test' value='/data/kunit/fs/fat/fat_test.ko' />
        <option name='binary' key='kernel/time/time_test' value='/data/kunit/kernel/time/time_test.ko' />
        <option name='binary' key='lib/kunit/kunit-example-test' value='/data/kunit/lib/kunit/kunit-example-test.ko' />
        <!-- <option name='binary' key='lib/kunit/kunit-test' value='/data/kunit/lib/kunit/kunit-test.ko' /> -->
        <!-- <option name='binary' key='mm/kfence/kfence_test' value='/data/kunit/mm/kfence/kfence_test.ko' /> -->
        <option name='binary' key='net/core/dev_addr_lists_test' value='/data/kunit/net/core/dev_addr_lists_test.ko' />
        <!-- <option name='binary' key='sound/soc/soc-topology-test' value='/data/kunit/sound/soc/soc-topology-test.ko' /> -->
        <option name='binary' key='sound/soc/soc-utils-test' value='/data/kunit/sound/soc/soc-utils-test.ko' />
    </test>
</configuration>
