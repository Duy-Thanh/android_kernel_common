      "writtenOn": "2025-11-25T23:20:26Z",
      "side": 1,
      "message": "I feel its better to take the lock for the whole period as it avoids an extra unlock/lock. Is there an advantage that you see in unlocking and locking again?",
      "parentUuid": "6f429e11_c221213a",
      "revId": "3034d4e62fe592b9fa62d8f842e0c4e8534d36b0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
