                "endLine": 428,
                "endChar": 0
              },
              "replacement": "        let mut guard \u003d device.inner.lock();\n"
            }
          ]
        }
      ],
      "revId": "2ddb2b9e5190db20b9cd369332c94d9a0f41d6e1",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "6851c525_ea7b29c5",
