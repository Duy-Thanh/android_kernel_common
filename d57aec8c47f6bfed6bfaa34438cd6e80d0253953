        "id": 1125653
      },
      "writtenOn": "2021-08-18T10:14:26Z",
      "side": 1,
      "message": "You should not need to do such a thing by a normal driver, especially a v4l2 driver.\n\nIf a driver needs to do this, then the driver framework for that bus/subsystem should already be doing this, please do not try to create a new user/kernel api interaction like this that is not accepted by upstream.",
      "parentUuid": "e0aba3e8_c9087589",
      "range": {
        "startLine": 2143,
        "startChar": 2,
        "endLine": 2143,
        "endChar": 21
      },
      "revId": "d57aec8c47f6bfed6bfaa34438cd6e80d0253953",
