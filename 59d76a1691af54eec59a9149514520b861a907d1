      "writtenOn": "2020-01-30T02:38:55Z",
      "side": 1,
      "message": "But I don\u0027t think passing it.node is the right thing to do here. Looking at nvdimm_*_region_create(), I\u0027d think np (the platform device\u0027s device_node) is the right thing to pass here.",
      "range": {
        "startLine": 113,
        "startChar": 40,
        "endLine": 113,
        "endChar": 44
      },
      "revId": "59d76a1691af54eec59a9149514520b861a907d1",
