      "writtenOn": "2025-11-21T18:27:46Z",
      "side": 1,
      "message": "Would we see fewer collisions with upstream changes to this function if sel_make_memfd_policycap() above was extended to handle the extra policies, and we just preserved the one line change to the return to call to handle the extensions?",
      "revId": "5af409d804660a509102873690e3819887312282",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
