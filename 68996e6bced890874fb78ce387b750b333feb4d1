      "writtenOn": "2023-08-19T00:15:29Z",
      "side": 1,
      "message": "Should we implement to let the device clean up effects / rumble settings that won\u0027t be used? (Presumably we have to store them on the device side since the kernel could write a dozen types of rumble settings before playing one of them.)",
      "range": {
        "startLine": 266,
        "startChar": 12,
        "endLine": 266,
        "endChar": 32
      },
      "revId": "68996e6bced890874fb78ce387b750b333feb4d1",
