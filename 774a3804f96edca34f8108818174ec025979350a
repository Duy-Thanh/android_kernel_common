      },
      "writtenOn": "2024-07-15T15:17:43Z",
      "side": 1,
      "message": "I am restricting it on line 2452 (find_mem_range) returns NULL if its MMIO",
      "parentUuid": "5c607b31_6b93fe72",
      "revId": "774a3804f96edca34f8108818174ec025979350a",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
