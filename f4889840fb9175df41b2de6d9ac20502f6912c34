      "writtenOn": "2026-09-02T10:22:59Z",
      "side": 1,
      "message": "Why are we inventing our own listener abstraction? Could this just be a generic `wait_queue_head_t` that drivers can register themselves with? Or do we expect this vtable to get more operations in the future?",
      "range": {
        "startLine": 15,
        "startChar": 0,
        "endLine": 17,
        "endChar": 2
      },
      "revId": "f4889840fb9175df41b2de6d9ac20502f6912c34",
