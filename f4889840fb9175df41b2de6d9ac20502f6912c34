    },
    {
      "unresolved": true,
      "key": {
        "uuid": "5667100a_f51e5991",
        "filename": "include/linux/wrapfd.h",
        "patchSetId": 1
      },
      "lineNbr": 17,
      "author": {
        "id": 1157738
      },
      "writtenOn": "2026-09-07T16:04:52Z",
      "side": 1,
      "message": "This callback has to be synchronous (wrapfd calls it, waits until the TPU driver unmaps the buffer and then frees it), so I don\u0027t think waitqueue works well for this case as it would require some kind of a handshake. A callback like it\u0027s implemented now is straight forward and simple, so I think it makes sense in this context.",
      "parentUuid": "3fc4027a_39eea538",
      "range": {
