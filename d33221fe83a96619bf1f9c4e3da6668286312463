        "id": 1965911
      },
      "writtenOn": "2025-01-13T12:19:15Z",
      "side": 1,
      "message": "The problem is that we don\u0027t have nested here, it\u0027s only stage-2, but we can unconditionally set `IOMMU_CACHE` and that would be combined with the transacation attributes.\nHowever, the upstream driver does assume that `coherent_walk` implies the master is coherent also.",
      "parentUuid": "5ff9d62e_df81f373",
      "range": {
        "startLine": 1580,
        "startChar": 43,
        "endLine": 1580,
        "endChar": 56
      },
      "revId": "d33221fe83a96619bf1f9c4e3da6668286312463",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
