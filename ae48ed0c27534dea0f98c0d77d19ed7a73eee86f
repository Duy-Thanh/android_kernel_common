        "id": 1432579
      },
      "writtenOn": "2025-04-21T21:55:54Z",
      "side": 1,
      "message": "Unless we are going to have a debug only microdroid kernel, we should keep the tracing related features enabled. Not being able to trace pVMs on droidfood / beta population will definitely be a blocker to launching anything inside a pVM.",
      "parentUuid": "77aaa26d_6dc20254",
      "range": {
        "startLine": 13,
        "startChar": 39,
        "endLine": 13,
        "endChar": 52
      },
      "revId": "ae48ed0c27534dea0f98c0d77d19ed7a73eee86f",
