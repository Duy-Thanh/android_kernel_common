      "writtenOn": "2023-01-31T17:14:55Z",
      "side": 1,
      "message": "It\u0027s created on first resume, and removed in dm_bow_dtr. But not arguing, this is weird.",
      "parentUuid": "f09c189c_229c98fe",
      "revId": "ae356ab1038e245b717920f8dcd987d2d9266505",
