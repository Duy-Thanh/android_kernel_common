              },
              "replacement": "\t\treturn -EBUSY;\n"
            }
          ]
        }
      ],
      "revId": "aec99fde482f2dca1b31c1e95dbe5d09bb5f6610",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "50f9362d_e95b91f8",
        "filename": "arch/x86/kvm/vmx/pkvm/hyp/pv_iommu.c",
