      "writtenOn": "2026-07-27T14:19:04Z",
      "side": 1,
      "message": "Unresolving this comment just to make it visible. Please feel free to resolve (since this is not exactly about this patch).",
      "parentUuid": "0561d3f1_95538413",
      "revId": "246398714a0fb05d1c22a45ce0c130c1067aec4e",
