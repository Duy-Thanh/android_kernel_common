      "writtenOn": "2024-04-18T20:47:34Z",
      "side": 1,
      "message": "Can all this be replaced with `bdev \u003d blkdev_get_by_path(file_name, ...)`? `blkdev_get_by_path` is already exported. That would even be an upstreamable change IMO.",
      "range": {
        "startLine": 494,
        "startChar": 0,
        "endLine": 511,
        "endChar": 17
      },
      "revId": "91adbfe6b62def07c89fb570a65d7abe498431b5",
