      },
      "writtenOn": "2025-01-17T21:57:47Z",
      "side": 1,
      "message": "Does it mean the size can only be set once?",
      "range": {
        "startLine": 202,
        "startChar": 1,
        "endLine": 202,
        "endChar": 48
      },
      "revId": "8f570371fbc828d6660f8da315d9fdb0ebc57827",
