      "writtenOn": "2025-01-17T22:12:18Z",
      "side": 1,
      "message": "Yes, I did this here--as opposed to in mmap--because I don\u0027t know if other usecases that use memfd for non-ashmem related purposes would need to change the file size (perhaps increase) after it has been mmap\u0027ed, since the mmap handler in this file will be invoked for all memfds, not just the ones used for ashmem.",
      "parentUuid": "9fb7baa4_29c1dbdf",
      "range": {
        "startLine": 202,
        "startChar": 1,
        "endLine": 202,
        "endChar": 48
      },
      "revId": "8f570371fbc828d6660f8da315d9fdb0ebc57827",
