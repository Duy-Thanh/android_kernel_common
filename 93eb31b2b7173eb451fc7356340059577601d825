      "author": {
        "id": 1125653
      },
      "writtenOn": "2021-04-16T07:17:09Z",
      "side": 1,
      "message": "You control the android code 😊\n\nRemember, this is the android-mainline branch, no devices use this at the moment, you can fix this up properly in userspace please.",
      "parentUuid": "8bfb89ac_afcd5b54",
      "range": {
        "startLine": 16,
        "startChar": 0,
        "endLine": 16,
        "endChar": 36
      },
      "revId": "93eb31b2b7173eb451fc7356340059577601d825",
