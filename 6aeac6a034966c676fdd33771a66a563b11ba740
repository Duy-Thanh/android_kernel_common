      "writtenOn": "2026-05-28T08:17:48Z",
      "side": 1,
      "message": "Why can\u0027t this be done in a module? Why should we carry this snake oil in ACK?",
      "range": {
        "startLine": 100,
        "startChar": 0,
        "endLine": 100,
        "endChar": 18
      },
      "revId": "6aeac6a034966c676fdd33771a66a563b11ba740",
