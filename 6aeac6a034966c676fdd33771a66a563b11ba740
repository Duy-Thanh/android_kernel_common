      "key": {
        "uuid": "6b002a49_6f1e8c08",
        "filename": "drivers/virt/gunyah/Kconfig",
        "patchSetId": 13
      },
      "lineNbr": 69,
      "author": {
        "id": 1069543
      },
      "writtenOn": "2026-05-28T22:34:15Z",
      "side": 1,
      "message": "\u003e On production Android builds we disable Live patching and KPROBES\n\nJust so we understand...how are you doing that? Is it being done in the EL2 gunyah code at \"freeze\"? (It can\u0027t be build-time \"for production Android builds\" since CONFIG_KPROBES is enabled for GKI kernels)",
      "parentUuid": "707710ee_4f26ff45",
      "range": {
        "startLine": 69,
        "startChar": 57,
        "endLine": 69,
        "endChar": 61
      },
      "revId": "6aeac6a034966c676fdd33771a66a563b11ba740",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
