      "writtenOn": "2026-05-29T12:00:32Z",
      "side": 1,
      "message": "This is about the host, not protected guests.\n\nWhat is a \"trusted protection contract\"? Why does it matter if the data is passed in memory or via a hypercall?",
      "parentUuid": "d9118019_bb8258cb",
      "range": {
        "startLine": 100,
        "startChar": 0,
        "endLine": 100,
        "endChar": 18
      },
      "revId": "6aeac6a034966c676fdd33771a66a563b11ba740",
