      "writtenOn": "2025-05-09T08:30:16Z",
      "side": 1,
      "message": "If you are interested in the ownership in just 6.6, please let me know, however our main development is switching to 6.12.",
      "parentUuid": "1f9230b5_100179ff",
      "revId": "34660ddc335d2b8988713f225cf436b5d9c157df",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
