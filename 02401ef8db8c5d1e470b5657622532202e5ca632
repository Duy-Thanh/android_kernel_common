      "writtenOn": "2018-04-24T14:12:02Z",
      "side": 1,
      "message": "Why is hardware platform support being done in the common tree?  Shouldn\u0027t this be in an SoC specific tree instead?",
      "parentUuid": "41703913_bc5163fe",
      "range": {
        "startLine": 33,
        "startChar": 0,
        "endLine": 33,
        "endChar": 52
      },
