    {
      "key": {
        "uuid": "3a58de33_951b6ec4",
        "filename": "drivers/mmc/host/cqhci-crypto.c",
        "patchSetId": 7
      },
      "lineNbr": 134,
      "author": {
        "id": 1661652
      },
      "writtenOn": "2020-04-07T10:20:15Z",
      "side": 1,
      "message": "cqhci_writel() function is legacy. I am not sure why this do not handle wmb() call but one reason can be that putting it inside the write call by default will always invoke barrier operation which might not be necessary in all scenarios. So it is up to user to decide when to invoke a memory barrier operation to ensure onus is on caller of the API and caller must be fully aware of the use case which is invoking a barrier operation.",
      "parentUuid": "6f3939af_ee9dfcc7",
      "range": {
        "startLine": 134,
        "startChar": 1,
        "endLine": 134,
        "endChar": 4
      },
