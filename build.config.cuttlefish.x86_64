. ${ROOT_DIR}/common/build.config.common
. ${ROOT_DIR}/common/build.config.x86_64
. ${ROOT_DIR}/common/build.config.gki

BUILD_INITRAMFS=1
DEFCONFIG=cf_x86_64_gki_defconfig
PRE_DEFCONFIG_CMDS="KCONFIG_CONFIG=./common/arch/x86/configs/${DEFCONFIG} ./common/scripts/kconfig/merge_config.sh -m -r ./common/arch/x86/configs/gki_defconfig ./common/cuttlefish.fragment"
POST_DEFCONFIG_CMDS="rm ./common/arch/x86/configs/${DEFCONFIG}"

# Not saving any kernel images. This build step is meant purely to generate the .kos.
FILES=""
