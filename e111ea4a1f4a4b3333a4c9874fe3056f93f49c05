      "message": "\u003e [Experimental] Cherry pick is not clean. These are the differences between the original change and this cherry-pick:\n\u003e Checked against UPSTREAM commit: [googlesource](https://android.googlesource.com/kernel/common/+/ff878b408a03bef5d610b7e2302702e16a53636e) [kernel.org](https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id\u003dff878b408a03bef5d610b7e2302702e16a53636e)\n\u003e \n\u003e ```\n\u003e       ## sound/usb/endpoint.c ##\n\u003e      @@ sound/usb/endpoint.c: bool snd_usb_endpoint_compatible(struct snd_usb_audio *chip,\n\u003e     @@ sound/usb/endpoint.c: bool snd_usb_endpoint_compatible(struct snd_usb_audio *chi\n\u003e        * Note that this function doesn\u0027t configure the endpoint.  The substream\n\u003e      - * needs to set it up later via snd_usb_endpoint_configure().\n\u003e      + * needs to set it up later via snd_usb_endpoint_set_params() and\n\u003e     -+ * snd_usb_endpoint_prepare().\n\u003e     ++ * snd_usb_endpoint_configure().\n\u003e        */\n\u003e       struct snd_usb_endpoint *\n\u003e       snd_usb_endpoint_open(struct snd_usb_audio *chip,\n\u003e     @@ sound/usb/endpoint.c: out_of_memory:\n\u003e       {\n\u003e       \tconst struct audioformat *fmt \u003d ep-\u003ecur_audiofmt;\n\u003e       \tint err;\n\u003e     -@@ sound/usb/endpoint.c: static int init_sample_rate(struct snd_usb_audio *chip,\n\u003e     +@@ sound/usb/endpoint.c: static int snd_usb_endpoint_set_params(struct snd_usb_audio *chip,\n\u003e       }\n\u003e       \n\u003e       /*\n\u003e      - * snd_usb_endpoint_configure: Configure the endpoint\n\u003e     -+ * snd_usb_endpoint_prepare: Prepare the endpoint\n\u003e     ++ * snd_usb_endpoint_configure: Prepare the endpoint\n\u003e        *\n\u003e        * This function sets up the EP to be fully usable state.\n\u003e      - * It\u0027s called either from hw_params or prepare callback.\n\u003e     @@ sound/usb/endpoint.c: static int init_sample_rate(struct snd_usb_audio *chip,\n\u003e        * The function checks need_setup flag, and performs nothing unless needed,\n\u003e        * so it\u0027s safe to call this multiple times.\n\u003e        *\n\u003e     -  * This returns zero if unchanged, 1 if the configuration has changed,\n\u003e     +@@ sound/usb/endpoint.c: static int snd_usb_endpoint_set_params(struct snd_usb_audio *chip,\n\u003e        * or a negative error code.\n\u003e        */\n\u003e     --int snd_usb_endpoint_configure(struct snd_usb_audio *chip,\n\u003e     + int snd_usb_endpoint_configure(struct snd_usb_audio *chip,\n\u003e      -\t\t\t       struct snd_usb_endpoint *ep)\n\u003e     -+int snd_usb_endpoint_prepare(struct snd_usb_audio *chip,\n\u003e      +\t\t\t     struct snd_usb_endpoint *ep)\n\u003e       {\n\u003e       \tbool iface_first;\n\u003e     @@ sound/usb/endpoint.h: snd_usb_endpoint_open(struct snd_usb_audio *chip,\n\u003e       \t\t      bool is_sync_ep);\n\u003e       void snd_usb_endpoint_close(struct snd_usb_audio *chip,\n\u003e       \t\t\t    struct snd_usb_endpoint *ep);\n\u003e     --int snd_usb_endpoint_configure(struct snd_usb_audio *chip,\n\u003e     --\t\t\t       struct snd_usb_endpoint *ep);\n\u003e      +int snd_usb_endpoint_set_params(struct snd_usb_audio *chip,\n\u003e      +\t\t\t\tstruct snd_usb_endpoint *ep);\n\u003e     -+int snd_usb_endpoint_prepare(struct snd_usb_audio *chip,\n\u003e     + int snd_usb_endpoint_configure(struct snd_usb_audio *chip,\n\u003e     +-\t\t\t       struct snd_usb_endpoint *ep);\n\u003e      +\t\t\t     struct snd_usb_endpoint *ep);\n\u003e       int snd_usb_endpoint_get_clock_rate(struct snd_usb_audio *chip, int clock);\n\u003e       \n\u003e       bool snd_usb_endpoint_compatible(struct snd_usb_audio *chip,\n\u003e      \n\u003e       ## sound/usb/pcm.c ##\n\u003e     -@@ sound/usb/pcm.c: static int configure_endpoints(struct snd_usb_audio *chip,\n\u003e     - \t\tif (stop_endpoints(subs, false))\n\u003e     - \t\t\tsync_pending_stops(subs);\n\u003e     - \t\tif (subs-\u003esync_endpoint) {\n\u003e     --\t\t\terr \u003d snd_usb_endpoint_configure(chip, subs-\u003esync_endpoint);\n\u003e     -+\t\t\terr \u003d snd_usb_endpoint_prepare(chip, subs-\u003esync_endpoint);\n\u003e     - \t\t\tif (err \u003c 0)\n\u003e     - \t\t\t\treturn err;\n\u003e     - \t\t}\n\u003e     --\t\terr \u003d snd_usb_endpoint_configure(chip, subs-\u003edata_endpoint);\n\u003e     -+\t\terr \u003d snd_usb_endpoint_prepare(chip, subs-\u003edata_endpoint);\n\u003e     - \t\tif (err \u003c 0)\n\u003e     - \t\t\treturn err;\n\u003e     - \t\tsnd_usb_set_format_quirk(subs, subs-\u003ecur_audiofmt);\n\u003e     - \t} else {\n\u003e     - \t\tif (subs-\u003esync_endpoint) {\n\u003e     --\t\t\terr \u003d snd_usb_endpoint_configure(chip, subs-\u003esync_endpoint);\n\u003e     -+\t\t\terr \u003d snd_usb_endpoint_prepare(chip, subs-\u003esync_endpoint);\n\u003e     - \t\t\tif (err \u003c 0)\n\u003e     - \t\t\t\treturn err;\n\u003e     - \t\t}\n\u003e      @@ sound/usb/pcm.c: static int snd_usb_hw_params(struct snd_pcm_substream *substream,\n\u003e       \tsubs-\u003ecur_audiofmt \u003d fmt;\n\u003e       \tmutex_unlock(\u0026chip-\u003emutex);\n\u003e ```\n\u003e \n\u003e Please refer to the contribution guidelines for details:\n\u003e https://android.googlesource.com/kernel/common/+/refs/heads/android-mainline/README.md\n\n\nThat looks like a non-trivial cherry-pick and as such should be `BACKPORT:` ? \n\nhttps://android.googlesource.com/kernel/common/+/refs/heads/android-mainline/README.md#requirements-for-backports-from-mainline-linux",
