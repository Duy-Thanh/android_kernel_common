      "writtenOn": "2026-10-16T15:42:16Z",
      "side": 1,
      "message": "That\u0027s quite a significant change from what was posted upstream!  Doesn\u0027t that mean this feature needs a newer kernel version to work?",
      "parentUuid": "95aaf783_c36f8370",
      "revId": "61d8dfad035d9450dc82a94c6d8e47cf8e494a71",
