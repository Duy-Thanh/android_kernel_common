      },
      "writtenOn": "2022-03-02T02:27:58Z",
      "side": 1,
      "message": "Where did this part come from? Also, I was thinking we can use val2 for the flags.",
      "range": {
        "startLine": 3889,
        "startChar": 0,
        "endLine": 3891,
        "endChar": 18
      },
      "revId": "1060ce97cd18de5bc2436f825abef0d4b69a5dc7",
