    },
    {
      "unresolved": true,
      "key": {
        "uuid": "c12aa701_5eb49429",
        "filename": "drivers/trusty/trusty-log.c",
        "patchSetId": 2
      },
      "lineNbr": 642,
      "author": {
        "id": 1000205
      },
      "writtenOn": "2022-05-18T16:52:13Z",
      "side": 1,
      "message": "Yes, but that if-statement is in a code path where f_pos and index will already get out of sync.",
      "parentUuid": "623b84d1_74747b62",
      "range": {
        "startLine": 642,
        "startChar": 22,
        "endLine": 642,
        "endChar": 27
      },
