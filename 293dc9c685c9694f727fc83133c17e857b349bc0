        "id": 1105075
      },
      "writtenOn": "2022-05-18T16:55:16Z",
      "side": 1,
      "message": "will the following read ops put them in sync considering the error message?",
      "parentUuid": "c12aa701_5eb49429",
      "range": {
        "startLine": 642,
        "startChar": 22,
        "endLine": 642,
        "endChar": 27
      },
      "revId": "293dc9c685c9694f727fc83133c17e857b349bc0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "39fe1cb7_f90b1d9a",
        "filename": "drivers/trusty/trusty-log.c",
