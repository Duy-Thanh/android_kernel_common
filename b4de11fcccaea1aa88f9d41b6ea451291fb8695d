      },
      "writtenOn": "2023-02-22T07:54:35Z",
      "side": 1,
      "message": "Actually, we have done some development in secrue-EL1 and Hypervisor to implement these feature.",
      "parentUuid": "341dd74c_421a5e0f",
      "range": {
        "startLine": 9,
        "startChar": 30,
        "endLine": 9,
        "endChar": 52
