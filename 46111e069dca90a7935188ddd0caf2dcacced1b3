      "writtenOn": "2023-03-13T13:07:01Z",
      "side": 1,
      "message": "Why do we need to take the minimum VL here? If we configure `ZCR_EL2` properly for the host, then won\u0027t it be clamped to `hyp_sve_max_vl` by construction?",
      "range": {
        "startLine": 211,
        "startChar": 8,
        "endLine": 211,
        "endChar": 11
      },
      "revId": "46111e069dca90a7935188ddd0caf2dcacced1b3",
