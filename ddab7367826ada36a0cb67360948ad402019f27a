        "id": 1137063
      },
      "writtenOn": "2024-02-20T22:07:05Z",
      "side": 1,
      "message": "Is it?  It covers why Android doesn\u0027t need the lockdown policy.  I don\u0027t see where it covers why this kernel patch should be backported.",
      "parentUuid": "9cf3a260_3125b022",
      "range": {
        "startLine": 9,
        "startChar": 1,
        "endLine": 12,
        "endChar": 60
      },
      "revId": "ddab7367826ada36a0cb67360948ad402019f27a",
