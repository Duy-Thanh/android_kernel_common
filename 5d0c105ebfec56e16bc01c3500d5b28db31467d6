      "lineNbr": 1115,
      "author": {
        "id": 1416371
      },
      "writtenOn": "2020-08-07T21:58:53Z",
      "side": 1,
      "message": "The intention is that the sender will use file sealing on the fd to drop permissions.\n\nThe userspace API is analogous to the domain socket API. If you want the receiver to have fewer permissions than you do, you need to create a reduced permission version of the fd first.",
      "parentUuid": "6b9c8f0f_92328ab3",
      "revId": "5d0c105ebfec56e16bc01c3500d5b28db31467d6",
