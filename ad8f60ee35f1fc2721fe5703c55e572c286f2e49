      },
      "writtenOn": "2025-02-10T13:06:51Z",
      "side": 1,
      "message": "Can we teardown `selftest_vm.pool` and free the pages back to the host as well?",
      "range": {
        "startLine": 2426,
        "startChar": 1,
        "endLine": 2426,
        "endChar": 19
      },
      "revId": "ad8f60ee35f1fc2721fe5703c55e572c286f2e49",
