      "writtenOn": "2026-02-10T10:01:06Z",
      "side": 1,
      "message": "@ptosi@google.com made a point about matching virtual and physical topologies, I don\u0027t thin we should support it now, but we should have a plan for it as it might be needed.",
      "parentUuid": "b3d5a3a6_f2bb9b48",
      "range": {
        "startLine": 216,
        "startChar": 1,
        "endLine": 216,
