      "writtenOn": "2024-06-02T10:55:21Z",
      "side": 1,
      "message": "how is this going to work with multiple instances of binder in the same system at the same time?",
      "range": {
        "startLine": 21,
        "startChar": 0,
        "endLine": 21,
        "endChar": 31
      },
      "revId": "a7a6adf1d6e867d882fb588c19d9b6bd66478993",
