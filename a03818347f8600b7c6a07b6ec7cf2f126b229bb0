      "lineNbr": 21,
      "author": {
        "id": 4426965
      },
      "writtenOn": "2026-09-17T13:45:16Z",
      "side": 1,
      "message": "but .. \"defaults to 0\"? it\u0027s something that\u0027s actually set separately (maybe it shouldn\u0027t be a separate op but done while installing the program?)",
      "parentUuid": "383a350b_a475d4de",
      "revId": "a03818347f8600b7c6a07b6ec7cf2f126b229bb0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
