      },
      "writtenOn": "2017-05-01T17:45:17Z",
      "side": 1,
      "message": "This is the place where the crash happens if we tag the socket, open the dev and then untag the socket. It crashes because this list is not added to any linked list when tagging the socket so the next and prev pointer point to nothing. So I added this check here to prevent that crash by checking the next pointer.",
      "parentUuid": "c1796e96_4a34e93e",
      "range": {
        "startLine": 2438,
        "startChar": 8,
        "endLine": 2438,
        "endChar": 38
